fn curl_get(url: string, extra: string) -> string is
    return shell("curl -sS -L -m 12 --max-filesize 4000000 " + extra + " " + util::sq(url) + " 2>/dev/null")
end

fn safe_url(u: string) -> bool is
    let t: string = string_trim(u)
    if !(string_starts_with(t, "http://") || string_starts_with(t, "https://")) is return false end
    return string_len(t) > 10 && !string_contains(t, " ") && !string_contains(t, "\n")
end

;; Strips tags, decodes the common entities, collapses whitespace.
fn clean(s: string, max: int) -> string is
    let mut out: string = ""
    let mut in_tag: bool = false
    let mut i: int = 0
    while i < string_len(s) is
        let ch: string = string_at(s, i)
        if ch == "<" is
            in_tag = true
        else if ch == ">" && in_tag is
            in_tag = false
        else if !in_tag is
            out = out + ch
        end
        i += 1
    end
    out = string_replace(out, "<![CDATA[", "")
    out = string_replace(out, "]]>", "")
    out = string_replace(string_replace(string_replace(out, "&amp;", "&"), "&lt;", "<"), "&gt;", ">")
    out = string_replace(string_replace(string_replace(out, "&quot;", "\""), "&#39;", "'"), "&nbsp;", " ")
    out = string_replace(string_replace(string_replace(out, "\n", " "), "\r", " "), "\t", " ")
    out = util::join(util::split_clean(out, " "), " ")
    if string_len(out) > max is out = string_slice(out, 0, max) + "…" end
    return out
end

;; ── search ───────────────────────────────────────────────────────────────────

fn tag_between(s: string, open: string, close: string) -> string is
    let a: int = string_find(s, open)
    if a < 0 is return "" end
    let rest: string = string_slice(s, a + string_len(open), string_len(s))
    let b: int = string_find(rest, close)
    if b < 0 is return "" end
    return string_slice(rest, 0, b)
end

fn ddg_redirect(href0: string) -> string is
    let href: string = if string_starts_with(href0, "//") then "https:" + href0 else href0
    let a: int = string_find(href, "uddg=")
    if string_contains(href, "duckduckgo.com/l/") && a >= 0 is
        let rest: string = string_slice(href, a + 5, string_len(href))
        let amp: int = string_find(rest, "&")
        return url_decode(if amp >= 0 then string_slice(rest, 0, amp) else rest)
    end
    return href
end

fn parse_ddg(page: string) -> [string] is
    let chunks: [string] = string_split(page, "class=\"result__a\"")
    let mut out: [string] = []
    let mut i: int = 1
    while i < array_len(chunks) && array_len(out) < 10 is
        let ch: string = chunks[i]
        let href: string = tag_between(ch, "href=\"", "\"")
        let gt: int = string_find(ch, ">")
        let title_end: int = string_find(ch, "</a>")
        let title: string = if gt >= 0 && title_end > gt then clean(string_slice(ch, gt + 1, title_end), 200) else ""
        let sn: int = string_find(ch, "result__snippet")
        let mut snippet: string = ""
        if sn >= 0 is
            let tail: string = string_slice(ch, sn, string_len(ch))
            let g2: int = string_find(tail, ">")
            let e2: int = string_find(tail, "</a>")
            if g2 >= 0 && e2 > g2 is snippet = clean(string_slice(tail, g2 + 1, e2), 300) end
        end
        let url: string = ddg_redirect(string_replace(href, "&amp;", "&"))
        if title != "" && safe_url(url) is
            out = array_push(out, util::jo([util::ks("title", title), util::ks("url", url), util::ks("snippet", snippet)]))
        end
        i += 1
    end
    return out
end

pub fn search(fd: int, c: [string]) is
    let q: string = string_trim(ctx::q(c, "q"))
    if q == "" || string_len(q) > 300 is
        http::err(fd, 502, "query must be 1–300 characters")
        return
    end
    let kind: string = config::search_provider()
    let mut results: [string] = []
    if kind == "brave" is
        if config::search_api_key() == "" is
            http::err(fd, 502, "HCKPT_SEARCH_API_KEY is required for the brave provider")
            return
        end
        let body: string = curl_get("https://api.search.brave.com/res/v1/web/search?q=" + url_encode(q) + "&count=10",
            "-H " + util::sq("X-Subscription-Token: " + config::search_api_key()) + " -H 'Accept: application/json' --compressed")
        let items: [string] = util::jitems(util::jget(util::jget(body, "web"), "results"))
        let mut i: int = 0
        while i < array_len(items) && array_len(results) < 10 is
            if safe_url(util::jstr(items[i], "url")) is
                results = array_push(results, util::jo([util::ks("title", clean(util::jstr(items[i], "title"), 200)), util::ks("url", util::jstr(items[i], "url")),
                    util::ks("snippet", clean(util::jstr(items[i], "description"), 300))]))
            end
            i += 1
        end
    else if kind == "searx" is
        if !safe_url(config::searx_url()) is
            http::err(fd, 502, "HCKPT_SEARX_URL must be an http(s) URL")
            return
        end
        let base: string = config::searx_url()
        let body: string = curl_get((if string_ends_with(base, "/") then string_slice(base, 0, string_len(base) - 1) else base) + "/search?format=json&q=" + url_encode(q), "")
        let items: [string] = util::jitems(util::jget(body, "results"))
        let mut i: int = 0
        while i < array_len(items) && array_len(results) < 10 is
            if safe_url(util::jstr(items[i], "url")) is
                results = array_push(results, util::jo([util::ks("title", clean(util::jstr(items[i], "title"), 200)), util::ks("url", util::jstr(items[i], "url")),
                    util::ks("snippet", clean(util::jstr(items[i], "content"), 300))]))
            end
            i += 1
        end
    else is
        let page: string = shell("curl -sS -L -m 12 --max-filesize 2000000 -A 'Mozilla/5.0 (X11; Linux x86_64) HackerCockpit/0.5' --data-urlencode " +
            util::sq("q=" + q) + " https://html.duckduckgo.com/html/ 2>/dev/null")
        results = parse_ddg(page)
    end
    http::respond_json(fd, 200, util::jo([util::kv("results", util::ja(results)), util::ks("provider", kind)]))
end

