fn feeds_for(topic: string) -> [string] is
    if topic == "gaming" is return ["https://www.ign.com/rss/articles.xml", "https://www.gamespot.com/feeds/news/"] end
    if topic == "cybersecurity" is return ["https://thehackernews.com/feeds/posts/default", "https://krebsonsecurity.com/feed/"] end
    if topic == "linux" is return ["https://www.phoronix.com/rss.php", "https://lwn.net/headlines/rss"] end
    return []
end

fn atom_link(entry: string) -> string is
    let parts: [string] = string_split(entry, "<link")
    let mut i: int = 1
    while i < array_len(parts) is
        let seg: string = parts[i]
        let gt: int = string_find(seg, ">")
        let attrs: string = if gt >= 0 then string_slice(seg, 0, gt) else seg
        if !string_contains(attrs, "rel=\"") || string_contains(attrs, "rel=\"alternate\"") is
            let h: string = tag_between(attrs, "href=\"", "\"")
            if safe_url(h) is return h end
        end
        i += 1
    end
    return ""
end

fn parse_feed(body: string) -> [string] is
    let mut out: [string] = []
    let is_atom: bool = string_contains(body, "<feed") && string_contains(body, "<entry")
    let src: string = clean(tag_between(body, "<title>", "</title>"), 60)
    let sep: string = if is_atom then "<entry" else "<item"
    let chunks: [string] = string_split(body, sep)
    let mut i: int = 1
    while i < array_len(chunks) && array_len(out) < 8 is
        let it: string = chunks[i]
        let traw: string = tag_between(it, "<title", "</title>")
        let tgt: int = string_find(traw, ">")
        let tt: string = clean(if tgt >= 0 then string_slice(traw, tgt + 1, string_len(traw)) else traw, 200)
        let mut link: string = ""
        let mut summary: string = ""
        let mut date: string = ""
        if is_atom is
            link = atom_link(it)
            let s1: string = tag_between(it, "<summary", "</summary>")
            let s2: string = tag_between(it, "<content", "</content>")
            let raw: string = if s1 != "" then s1 else s2
            let g: int = string_find(raw, ">")
            summary = clean(if g >= 0 then string_slice(raw, g + 1, string_len(raw)) else raw, 220)
            date = string_trim(tag_between(it, "<updated>", "</updated>"))
        else is
            link = string_trim(clean(tag_between(it, "<link>", "</link>"), 500))
            if !safe_url(link) is link = string_trim(clean(tag_between(it, "<guid", "</guid>"), 500)) end
            let g3: int = string_find(link, ">")
            if g3 >= 0 && !safe_url(link) is link = string_trim(string_slice(link, g3 + 1, string_len(link))) end
            if !safe_url(link) is link = "" end
            summary = clean(tag_between(it, "<description>", "</description>"), 220)
            date = string_trim(tag_between(it, "<pubDate>", "</pubDate>"))
        end
        if tt != "" is
            out = array_push(out, util::jo([util::ks("title", tt), util::ks("link", link), util::ks("summary", summary), util::ks("source", src), util::ks("date", date)]))
        end
        i += 1
    end
    return out
end

pub fn news(fd: int, c: [string], topic: string) is
    let feeds: [string] = feeds_for(topic)
    if array_len(feeds) == 0 is
        http::err(fd, 404, "unknown topic")
        return
    end
    let cache: string = config::data_dir() + "/news-" + topic + ".json"
    if file_exists(cache) && now_unix() - fs_mtime_s(cache) < 600 is
        http::respond_json(fd, 200, util::jo([util::kv("news", file_read(cache)), util::ks("topic", topic)]))
        return
    end
    let mut all: [string] = []
    let mut i: int = 0
    while i < array_len(feeds) is
        all = array_concat(all, parse_feed(curl_get(feeds[i], "-A HackerCockpit/0.5")))
        i += 1
    end
    while array_len(all) > 16 is all = util::remove_at(all, array_len(all) - 1) end
    let doc: string = util::ja(all)
    shell("mkdir -p " + util::sq(config::data_dir()))
    util::write_private(cache, doc)
    http::respond_json(fd, 200, util::jo([util::kv("news", doc), util::ks("topic", topic)]))
end

fn fs_mtime_s(p: string) -> int is
    return util::to_i(shell("stat -c %Y " + util::sq(p) + " 2>/dev/null"))
end

