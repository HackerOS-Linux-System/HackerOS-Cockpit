fn host_valid(h: string) -> string is
    let name: string = util::jstr(h, "name")
    if name == "" || string_len(name) > 60 is return "host name required (max 60 chars)" end
    let u: string = util::jstr(h, "url")
    let stripped: string = if string_ends_with(u, "/") then string_slice(u, 0, string_len(u) - 1) else u
    let scheme_end: int = string_find(stripped, "://")
    if !safe_url(stripped) || scheme_end < 0 || string_contains(string_slice(stripped, scheme_end + 3, string_len(stripped)), "/") is
        return "URL must look like https://host:4545"
    end
    return ""
end

fn host_curl(h: string, method: string, path: string, body: string) -> [string] is
    let base: string = util::jstr(h, "url")
    let url: string = (if string_ends_with(base, "/") then string_slice(base, 0, string_len(base) - 1) else base) + path
    let mut cmd: string = "curl -sS -m 5 -o - -w '\\n@@%{{http_code}} %{{time_total}}' -X " + method
    if util::jstr(h, "token") != "" is cmd = cmd + " -H " + util::sq("Authorization: Bearer " + util::jstr(h, "token")) end
    if util::jbool(h, "insecure") is cmd = cmd + " -k" end
    if body != "" is cmd = cmd + " -H 'Content-Type: application/json' --data-binary " + util::sq(body) end
    let out: string = shell(cmd + " " + util::sq(url) + " 2>&1")
    let at: int = string_rfind(out, "\n@@")
    if at < 0 is return [out, "0", "0"] end
    let meta: [string] = util::split_clean(string_slice(out, at + 3, string_len(out)), " ")
    let ms: int = if array_len(meta) > 1 then util::to_i(string_replace(meta[1], ".", "")) / 1000 else 0
    return [string_slice(out, 0, at), meta[0], to_string(ms)]
end

pub fn fleet(fd: int, c: [string]) is
    let hosts: [string] = util::jitems(settings::hosts())
    let mut rows: [string] = []
    let mut i: int = 0
    while i < array_len(hosts) is
        let h: string = hosts[i]
        let name: string = util::jstr(h, "name")
        let url: string = util::jstr(h, "url")
        let ve: string = host_valid(h)
        if ve != "" is
            rows = array_push(rows, util::jo([util::ks("name", name), util::ks("url", url), util::kv("ok", "false"), util::ks("error", ve), util::kv("latency_ms", "0")]))
        else is
            let r: [string] = host_curl(h, "GET", "/api/system", "")
            if r[1] == "000" || r[1] == "0" is
                rows = array_push(rows, util::jo([util::ks("name", name), util::ks("url", url), util::kv("ok", "false"), util::ks("error", "unreachable"), util::kv("latency_ms", r[2])]))
            else if r[1] != "200" is
                rows = array_push(rows, util::jo([util::ks("name", name), util::ks("url", url), util::kv("ok", "false"), util::ks("error", "HTTP " + r[1]), util::kv("latency_ms", r[2])]))
            else is
                rows = array_push(rows, util::jo([util::ks("name", name), util::ks("url", url), util::kv("ok", "true"), util::kv("latency_ms", r[2]), util::kv("info", string_trim(r[0]))]))
            end
        end
        i += 1
    end
    http::respond_json(fd, 200, util::jo([util::kv("hosts", util::ja(rows))]))
end

fn find_host(name: string) -> string is
    let hosts: [string] = util::jitems(settings::hosts())
    let mut i: int = 0
    while i < array_len(hosts) is
        if util::jstr(hosts[i], "name") == name is return hosts[i] end
        i += 1
    end
    return ""
end

fn relay(fd: int, h: string, method: string, path: string, body: string) is
    let ve: string = host_valid(h)
    if ve != "" is
        http::err(fd, 502, ve)
        return
    end
    let r: [string] = host_curl(h, method, path, body)
    if r[1] == "0" || r[1] == "000" is
        http::err(fd, 502, "unreachable: " + string_trim(r[0]))
        return
    end
    if r[1] == "401" is
        http::err(fd, 502, "the stored token for this host was rejected — check Settings → Fleet")
        return
    end
    http::respond(fd, util::to_i(r[1]), "application/json; charset=utf-8", "", r[0])
end

pub fn fleet_services(fd: int, c: [string], name: string) is
    let h: string = find_host(name)
    if h == "" is
        http::err(fd, 404, "no such fleet host")
        return
    end
    relay(fd, h, "GET", "/api/services", "")
end

pub fn fleet_action(fd: int, c: [string], name: string) is
    let h: string = find_host(name)
    if h == "" is
        http::err(fd, 404, "no such fleet host")
        return
    end
    let b: string = util::jo([util::ks("name", ctx::bstr(c, "name")), util::ks("action", ctx::bstr(c, "action"))])
    audit::log(ctx::user(c), "fleet.service." + ctx::bstr(c, "action"), name + ": " + ctx::bstr(c, "name"))
    relay(fd, h, "POST", "/api/services/action", b)
end

pub fn host_validate_all(hosts_raw: string) -> string is
    let hosts: [string] = util::jitems(hosts_raw)
    let mut i: int = 0
    while i < array_len(hosts) is
        let e: string = host_valid(hosts[i])
        if e != "" is return e end
        i += 1
    end
    return ""
end

;; ── pentest ──────────────────────────────────────────────────────────────────

fn profile_args(tool: string, profile: string) -> string is
    if tool == "nmap" is
        if profile == "quick" is return "-F -sV --open" end
        if profile == "default" is return "-sV --open" end
        if profile == "full" is return "-p- -sV --open -T4" end
        if profile == "scripts" is return "-sC -sV --open" end
        if profile == "ping" is return "-sn" end
    end
    if tool == "nikto" && profile == "default" is return "-h" end
    if tool == "whois" && profile == "default" is return "" end
    return "?"
end

pub fn target_ok(t: string) -> bool is
    if string_len(t) < 1 || string_len(t) > 200 is return false end
    if !(string_contains(util::alnum(), string_at(t, 0)) || string_at(t, 0) == "_") is return false end
    return util::all_in(t, util::alnum() + "_.-:/")
end

pub fn pentest_tools(fd: int, c: [string]) is
    let avail: string = util::jo([util::kv("nmap", util::jb(util::have("nmap"))), util::kv("nikto", util::jb(util::have("nikto"))), util::kv("whois", util::jb(util::have("whois")))])
    let profiles: string = util::jo([util::kv("nmap", util::jstrs(["quick", "default", "full", "scripts", "ping"])), util::kv("nikto", util::jstrs(["default"])), util::kv("whois", util::jstrs(["default"]))])
    http::respond_json(fd, 200, util::jo([util::kv("available", avail), util::kv("profiles", profiles)]))
end

pub fn pentest_stream(fd: int, c: [string]) is
    let tool: string = ctx::bstr(c, "tool")
    let mut profile: string = ctx::bstr(c, "profile")
    let target: string = ctx::bstr(c, "target")
    if !target_ok(target) is
        http::err(fd, 400, "invalid target")
        return
    end
    audit::log(ctx::user(c), "pentest." + tool, profile + " " + target)
    if profile == "" is profile = "default" end
    let args: string = profile_args(tool, profile)
    sys::sse_begin(fd)
    if !util::has(["nmap", "nikto", "whois"], tool) is
        sys::sse_done(fd, false, "unsupported tool")
        return
    end
    if args == "?" is
        sys::sse_done(fd, false, "unsupported profile \"" + profile + "\" for " + tool)
        return
    end
    if !util::have(tool) is
        sys::sse_done(fd, false, tool + " is not installed")
        return
    end
    let cmd: string = "timeout " + to_string(config::pentest_timeout()) + " " + tool + (if args == "" then "" else " " + args) + " " + util::sq(target)
    let full: string = if tool == "nmap" && profile == "ping" then sys::priv(cmd) else cmd
    sys::stream_cmd_nohdr(fd, full)
end
