    ;; ── terminal / pentest / search / news ──────────────────────────────
    if string_starts_with(p, "/api/terminal") is
        if p == "/api/terminal" && m == "POST" is
            if feature(fd, config::f_terminal()) && guard(fd, c, "admin") is m_term::terminal_exec(fd, c) end
