    ;; ── backups ─────────────────────────────────────────────────────────
    if string_starts_with(p, "/api/backups") is
        if !config::f_backup() is
            http::err_code(fd, 404, "feature_disabled", "this feature is disabled")
            return
        end
        if p == "/api/backups" && m == "GET" is
            if guard(fd, c, "operator") is m_backup::backups(fd, c) end
            return
        end
        if p == "/api/backups" && m == "POST" is
            if guard(fd, c, "operator") is m_backup::backup_save(fd, c, "") end
            return
        end
        let id: string = seg(p, "/api/backups/")
        let rest: string = after_seg(p, "/api/backups/")
        if rest == "" && m == "PUT" is
            if guard(fd, c, "operator") is m_backup::backup_save(fd, c, id) end
            return
        end
        if rest == "" && m == "DELETE" is
            if guard(fd, c, "operator") is m_backup::backup_delete(fd, c, id) end
            return
        end
        if rest == "/run/stream" && m == "POST" is
            if guard(fd, c, "operator") is m_backup::backup_run(fd, c, id) end
            return
        end
        if rest == "/snapshots" && m == "GET" is
            if guard(fd, c, "operator") is m_backup::backup_snapshots(fd, c, id) end
