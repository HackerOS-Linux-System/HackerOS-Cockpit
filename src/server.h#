        end
        if p == "/api/terminal/ws" && m == "GET" is
            if feature(fd, config::f_pty()) && guard(fd, c, "admin") is m_term::terminal_ws(fd, c) end
            return
        end
        if p == "/api/terminal/sessions" && m == "GET" is
            if feature(fd, config::f_pty()) && guard(fd, c, "admin") is m_term::sessions(fd, c) end
            return
        end
        if string_starts_with(p, "/api/terminal/sessions/") && m == "DELETE" is
            if feature(fd, config::f_pty()) && guard(fd, c, "admin") is m_term::session_close(fd, c, tail_after(p, "/api/terminal/sessions/")) end
            return
        end
    end
    if p == "/api/pentest/tools" && m == "GET" is
        if feature(fd, config::f_pentest()) && guard(fd, c, "admin") is m_misc::pentest_tools(fd, c) end
        return
    end
    if p == "/api/pentest/stream" && m == "POST" is
        if feature(fd, config::f_pentest()) && guard(fd, c, "admin") && limited(fd, c, "pentest", 4, 60) is m_misc::pentest_stream(fd, c) end
        return
    end
    if p == "/api/search" && m == "GET" is
        if feature(fd, config::f_search()) && guard(fd, c, "viewer") && limited(fd, c, "search", 20, 60) is m_misc::search(fd, c) end
        return
    end
    if string_starts_with(p, "/api/news/") && m == "GET" is
        if feature(fd, config::f_news()) && guard(fd, c, "viewer") is m_misc::news(fd, c, tail_after(p, "/api/news/")) end
        return
    end

    if string_starts_with(p, "/api/") is
        if ctx::user(c) == "" is
            http::err_code(fd, 401, "unauthenticated", "authentication required")
        else is
            http::err(fd, 404, "not found")
        end
        return
    end
    http::err(fd, 404, "not found")
end

;; Disabled-feature gate (answers 404 like the Go build's feature() wrapper).
fn feature(fd: int, on: bool) -> bool is
    if on is return true end
    http::err_code(fd, 404, "feature_disabled", "this feature is disabled")
    return false
end

;; Per-user sliding-window limiter for expensive actions.
fn limited(fd: int, c: [string], name: string, max: int, window: int) -> bool is
    let key: string = "act:" + name + ":" + ctx::user(c)
    let w: int = auth::rl_blocked(key, max, window)
    if w > 0 is
        http::respond_json_h(fd, 429, "Retry-After: " + to_string(w) + "\r\n", util::jo([util::ks("status", "error"), util::ks("message", "too many requests — slow down")]))
        return false
    end
    auth::rl_fail(key, window)
    return true
end

fn handle(fd: int) is
    process(fd, http::read_request(fd), net::peer_ip(fd))
end

;; Handles one already-read request (also the unit-test entry point).
pub fn process(fd: int, raw: string, peer: string) is
    if raw == "" is return end
    let head: string = http::head_of(raw)
    let target: string = http::target_of(head)
    let mut ip: string = peer
    if config::trust_proxy() && http::header(head, "X-Forwarded-For") != "" is
        ip = string_trim(string_split(http::header(head, "X-Forwarded-For"), ",")[0])
    end
    let tok: string = util::cookie_get(http::header(head, "Cookie"), auth::cookie_name())
    let c: [string] = ctx::make(http::method_of(head), http::path_of(target), http::query_of(target),
                                head, http::body_of(raw), ip, tok)
    route(fd, c)
end

;; Never returns. Parent keeps accepting; each connection runs in a child.
pub fn serve(host: string, port: int) -> int is
    let lfd: int = net::tcp_listen(host, port)
    if lfd < 0 is return 1 end
    net::ignore_sigchld()
    while true is
        let fd: int = net::tcp_accept(lfd)
        if fd >= 0 is
            let pid: int = net::proc_fork()
            if pid == 0 is
                net::fd_close(lfd)
                handle(fd)
                net::fd_close(fd)
                net::proc_exit(0)
            end
            net::fd_close(fd)
        end
    end
    return 0
end
