pub fn str_bytes(s: string) -> [int] is
    let n: int = string_len(s)
    let mut out: [int] = []
    let mut i: int = 0
    while i < n is
        out = array_push(out, str_to_char_code(string_at(s, i)) & 255)
        i += 1
    end
    return out
end

pub fn hex_of(b: [int]) -> string is
    let digits: string = "0123456789abcdef"
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(b) is
        let v: int = b[i] & 255
        out = out + string_at(digits, v >> 4) + string_at(digits, v & 15)
        i += 1
    end
    return out
end

;; Native H# arrays are shared handles and `array_push` / `a[i] = x` mutate in place,
;; so a plain `let mut b = a` ALIASES `a`. Always copy before mutating an argument.
pub fn copy_ints(a: [int]) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < array_len(a) is
        out = array_push(out, a[i])
        i += 1
    end
    return out
end

fn hex_val(c: string) -> int is
    let p: int = string_find("0123456789abcdef", string_lower(c))
    return p
end

pub fn bytes_of_hex(h: string) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i + 1 < string_len(h) is
        let a: int = hex_val(string_at(h, i))
        let b: int = hex_val(string_at(h, i + 1))
        if a < 0 || b < 0 is return [] end
        out = array_push(out, a * 16 + b)
        i += 2
    end
    return out
end

;; Constant-time comparison of two byte arrays.
pub fn ct_eq(a: [int], b: [int]) -> bool is
    if array_len(a) != array_len(b) is return false end
    let mut diff: int = 0
    let mut i: int = 0
    while i < array_len(a) is
        diff = diff | (a[i] ^ b[i])
        i += 1
    end
    return diff == 0
end

pub fn ct_eq_str(a: string, b: string) -> bool is
    return ct_eq(str_bytes(a), str_bytes(b))
end

