    fn socket(domain: int, kind: int, proto: int) -> int
    fn setsockopt(fd: int, level: int, opt: int, val: int, len: int) -> int
    fn bind(fd: int, addr: int, len: int) -> int
    fn listen(fd: int, backlog: int) -> int
    fn accept(fd: int, addr: int, len: int) -> int
    fn recv(fd: int, buf: int, n: int, flags: int) -> int
    fn send(fd: int, buf: int, n: int, flags: int) -> int
    fn close(fd: int) -> int
    fn fork() -> int
    fn waitpid(pid: int, status: int, opts: int) -> int
    fn signal(sig: int, handler: int) -> int
    fn malloc(size: int) -> int
