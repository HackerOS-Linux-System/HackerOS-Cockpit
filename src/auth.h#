mod util
mod crypto
mod config
mod net

;; Iterations for NEW hashes (Go default 310000). HCKPT_PBKDF2_ITER may lower it
;; for slow hardware / tests; stored hashes always verify with their own count.
fn pbkdf2_iter() -> int is
    let v: string = env_get("HCKPT_PBKDF2_ITER")
    if v != "" && util::is_digits(v) && util::to_i(v) >= 1000 is return util::to_i(v) end
    return 310000
end

;; ── passwords ────────────────────────────────────────────────────────────────

pub fn hash_password(password: string) -> string is
    if string_len(password) > 1024 is return "" end
    let salt: [int] = crypto::rand_bytes(16)
    let key: [int] = crypto::pbkdf2_sha256(crypto::str_bytes(password), salt, pbkdf2_iter(), 32)
    return "pbkdf2-sha256$" + to_string(pbkdf2_iter()) + "$" + crypto::b64_encode_raw(salt) + "$" + crypto::b64_encode_raw(key)
end

pub fn verify_password(password: string, encoded: string) -> bool is
    if string_len(password) > 1024 is return false end
    let parts: [string] = string_split(encoded, "$")
    if array_len(parts) != 4 || parts[0] != "pbkdf2-sha256" is return false end
    if !util::is_digits(parts[1]) is return false end
    let iter: int = util::to_i(parts[1])
    if iter < 1000 || iter > 5000000 is return false end
    let salt: [int] = crypto::b64_decode_raw(parts[2])
    let want: [int] = crypto::b64_decode_raw(parts[3])
    if array_len(salt) == 0 || array_len(want) == 0 is return false end
    let got: [int] = crypto::pbkdf2_sha256(crypto::str_bytes(password), salt, iter, array_len(want))
    return crypto::ct_eq(got, want)
end

pub fn valid_username(name: string) -> bool is
    let n: int = string_len(name)
    if n < 1 || n > 32 is return false end
    if !string_contains(util::alnum(), string_at(name, 0)) is return false end
    return util::all_in(name, util::alnum() + "._-")
end

pub fn valid_password(p: string) -> string is
    if string_len(p) < 10 is return "password must be at least 10 characters" end
    if string_len(p) > 1024 is return "password too long" end
    return ""
end

;; ── roles ────────────────────────────────────────────────────────────────────

pub fn role_rank(role: string) -> int is
    let r: string = string_lower(string_trim(role))
    if r == "viewer" is return 1 end
    if r == "operator" is return 2 end
    if r == "admin" is return 3 end
    return 0
end

pub fn role_allows(role: string, min: string) -> bool is
    let r: int = role_rank(role)
    return r != 0 && r >= role_rank(min)
end

;; ── user store (auth.json) ───────────────────────────────────────────────────

pub fn store_path() -> string is return config::data_dir() + "/auth.json" end

fn read_store() -> string is
    if !file_exists(store_path()) is return "" end
    return file_read(store_path())
end

pub fn user_objects() -> [string] is
    return util::jitems(util::jget(read_store(), "users"))
end

;; Raw JSON object of a user ("" when unknown).
pub fn user_find(name: string) -> string is
    let us: [string] = user_objects()
    let mut i: int = 0
    while i < array_len(us) is
        if util::jstr(us[i], "username") == name is return us[i] end
        i += 1
    end
    return ""
end

fn write_users(objs: [string], tokens_raw: string) is
    let toks: string = if tokens_raw == "" then "[]" else tokens_raw
    let doc: string = "{{\"users\":" + util::ja(objs) + ",\"tokens\":" + toks + "}}"
    shell("mkdir -p " + util::sq(config::data_dir()) + " && chmod 700 " + util::sq(config::data_dir()))
    util::write_private(store_path(), doc)
end

pub fn user_object(name: string, hash: string, role: string) -> string is
    return util::jo([util::ks("username", name), util::ks("password_hash", hash),
                     util::ks("role", role), util::ks("created", util::now_iso())])
end

pub fn random_password() -> string is
    let raw: [int] = crypto::rand_bytes(18)
    return string_replace(string_replace(crypto::b64url_encode_raw(raw), "-", "x"), "_", "y")
end

;; First start: creates `admin` with a random password (returned so main can
;; print it once). Returns "" when a store with users already exists.
pub fn ensure_store() -> string is
    if array_len(user_objects()) > 0 is return "" end
    let pw: string = random_password()
    write_users([user_object("admin", hash_password(pw), "admin")], util::jget(read_store(), "tokens"))
    return pw
end

;; Verifies credentials; returns the user's raw JSON on success, "" otherwise.
;; Unknown users still burn one hash so timing does not reveal existence.
pub fn verify_user(name: string, password: string) -> string is
    let u: string = user_find(name)
    if u == "" is
        verify_password(password, "pbkdf2-sha256$" + to_string(pbkdf2_iter()) + "$AAAAAAAAAAAAAAAAAAAAAA$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
        return ""
    end
    if !verify_password(password, util::jstr(u, "password_hash")) is return "" end
    if util::jbool(u, "disabled") is return "" end
    return u
end

pub fn active_admins_except(name: string) -> int is
    let us: [string] = user_objects()
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(us) is
        if util::jstr(us[i], "username") != name && !util::jbool(us[i], "disabled") && role_rank(util::jstr(us[i], "role")) == 3 is n += 1 end
        i += 1
    end
    return n
end

;; Replaces one field of a user object (string value) and persists.
pub fn user_set_str(name: string, key: string, value: string) -> bool is
    let us: [string] = user_objects()
    let mut out: [string] = []
    let mut found: bool = false
    let mut i: int = 0
    while i < array_len(us) is
        if util::jstr(us[i], "username") == name is
            found = true
            out = array_push(out, rebuild_with(us[i], key, util::jq(value)))
        else is
            out = array_push(out, us[i])
        end
        i += 1
    end
    if found is write_users(out, util::jget(read_store(), "tokens")) end
    return found
end

;; Rebuilds a flat-or-nested object with `key` replaced/added by raw JSON.
fn rebuild_with(obj: string, key: string, raw: string) -> string is
    let inner: string = string_trim(obj)
    let body: string = string_trim(string_slice(inner, 1, string_len(inner) - 1))
    let keys: [string] = object_keys(body)
    let mut pairs: [string] = []
    let mut seen: bool = false
    let mut i: int = 0
    while i < array_len(keys) is
        if keys[i] == key is
            pairs = array_push(pairs, util::kv(key, raw))
            seen = true
        else is
            pairs = array_push(pairs, util::kv(keys[i], util::jget(obj, keys[i])))
        end
        i += 1
    end
    if !seen is pairs = array_push(pairs, util::kv(key, raw)) end
    return util::jo(pairs)
end

fn object_keys(body: string) -> [string] is
    let n: int = string_len(body)
    let mut keys: [string] = []
    let mut depth: int = 0
    let mut in_str: bool = false
    let mut start: int = 0
    let mut i: int = 0
    let mut at_key: bool = true
    while i < n is
        let c: string = string_at(body, i)
        if in_str is
            if c == "\\" is
                i += 1
            else if c == "\"" is
                in_str = false
                if depth == 0 && at_key is
                    keys = array_push(keys, util::junq(string_slice(body, start, i + 1)))
                    at_key = false
                end
            end
        else is
            if c == "\"" is
                in_str = true
                start = i
            else if c == "{{" || c == "[" is
                depth += 1
            else if c == "}}" || c == "]" is
                depth -= 1
            else if c == "," && depth == 0 is
                at_key = true
            end
        end
        i += 1
    end
    return keys
end

;; ── sessions (one file per session, named by sha256(token)) ─────────────────

pub fn cookie_name() -> string is return "hckpt_session" end

fn sess_dir() -> string is return config::data_dir() + "/sessions" end
fn sess_file(token: string) -> string is return sess_dir() + "/" + crypto::sha256_hex(token) end

pub fn new_token() -> string is
    return crypto::b64url_encode_raw(crypto::rand_bytes(32))
end

pub fn session_create(username: string, ip: string, agent: string) -> string is
    shell("mkdir -p " + util::sq(sess_dir()) + " && chmod 700 " + util::sq(sess_dir()))
    let tok: string = new_token()
    let now: int = now_unix()
    let doc: string = util::jo([util::ks("username", username), util::kv("created", util::ji(now)),
                                util::kv("last_seen", util::ji(now)), util::ks("ip", ip), util::ks("agent", agent)])
    util::write_private(sess_file(tok), doc)
    return tok
end

;; Username for a live session ("" otherwise); refreshes the idle timer and
;; deletes expired sessions.
pub fn session_user(token: string) -> string is
    if token == "" || !util::all_in(token, util::alnum() + "-_") is return "" end
    let f: string = sess_file(token)
    if !file_exists(f) is return "" end
    let doc: string = file_read(f)
    let now: int = now_unix()
    let created: int = util::jint(doc, "created")
    let seen: int = util::jint(doc, "last_seen")
    if now - created > config::session_ttl() || now - seen > config::idle_ttl() is
        fs_remove(f)
        return ""
    end
    let name: string = util::jstr(doc, "username")
    let u: string = user_find(name)
    if u == "" || util::jbool(u, "disabled") is
        fs_remove(f)
        return ""
    end
    if now - seen > 30 is
        let refreshed: string = util::jo([util::ks("username", name), util::kv("created", util::ji(created)),
                                          util::kv("last_seen", util::ji(now)), util::ks("ip", util::jstr(doc, "ip")),
                                          util::ks("agent", util::jstr(doc, "agent"))])
        util::write_private(f, refreshed)
    end
    return name
end

pub fn session_destroy(token: string) is
    if token != "" && util::all_in(token, util::alnum() + "-_") is fs_remove(sess_file(token)) end
end

;; JSON array of a user's sessions; `current` marks the caller's own.
pub fn sessions_json(username: string, current_token: string) -> string is
    let files: [string] = fs_list_dir(sess_dir())
    let cur: string = if current_token == "" then "" else crypto::sha256_hex(current_token)
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(files) is
        let id: string = util::basename(files[i])
        let doc: string = file_read(sess_dir() + "/" + id)
        if util::jstr(doc, "username") == username is
            out = array_push(out, util::jo([util::ks("id", id), util::ks("username", username),
                util::kv("created", util::jq(iso_of(util::jint(doc, "created")))),
                util::kv("last_seen", util::jq(iso_of(util::jint(doc, "last_seen")))),
                util::ks("ip", util::jstr(doc, "ip")), util::ks("agent", util::jstr(doc, "agent")),
                util::kv("current", util::jb(id == cur))]))
        end
        i += 1
    end
    return util::ja(out)
end

pub fn session_kill_id(username: string, id: string) -> bool is
    if !util::all_in(id, "0123456789abcdef") || string_len(id) != 64 is return false end
    let f: string = sess_dir() + "/" + id
    if !file_exists(f) is return false end
    if util::jstr(file_read(f), "username") != username is return false end
    fs_remove(f)
    return true
end

pub fn sessions_destroy_user_except(username: string, keep_token: string) -> int is
    let keep: string = if keep_token == "" then "" else crypto::sha256_hex(keep_token)
    let files: [string] = fs_list_dir(sess_dir())
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(files) is
        let id: string = util::basename(files[i])
        if id != keep && util::jstr(file_read(sess_dir() + "/" + id), "username") == username is
            fs_remove(sess_dir() + "/" + id)
            n += 1
        end
        i += 1
    end
    return n
end

fn iso_of(unix: int) -> string is
    return string_trim(shell("date -u -d @" + to_string(unix) + " +%Y-%m-%dT%H:%M:%SZ"))
end

;; ── brute-force limiter (timestamps per key, one file each) ─────────────────

fn rl_file(key: string) -> string is
    return config::data_dir() + "/ratelimit/" + crypto::sha256_hex(key)
end

fn rl_hits(key: string, window: int) -> [string] is
    let f: string = rl_file(key)
    let mut out: [string] = []
    if !file_exists(f) is return out end
    let now: int = now_unix()
    let ls: [string] = string_split(file_read(f), "\n")
    let mut i: int = 0
    while i < array_len(ls) is
        if util::is_digits(ls[i]) && now - util::to_i(ls[i]) < window is out = array_push(out, ls[i]) end
        i += 1
    end
    return out
end

;; Seconds to wait (0 = not blocked).
pub fn rl_blocked(key: string, max: int, window: int) -> int is
    let h: [string] = rl_hits(key, window)
    if array_len(h) < max is return 0 end
    let wait: int = util::to_i(h[0]) + window - now_unix()
    if wait < 1 is return 1 end
    return wait
end

pub fn rl_fail(key: string, window: int) is
    shell("mkdir -p " + util::sq(config::data_dir() + "/ratelimit"))
    let h: [string] = rl_hits(key, window)
    let all: [string] = array_push(h, to_string(now_unix()))
    util::write_private(rl_file(key), util::join(all, "\n"))
end

pub fn rl_reset(key: string) is
    if file_exists(rl_file(key)) is fs_remove(rl_file(key)) end
end

;; ── pending 2FA logins (5 minutes, bound to client IP) ───────────────────────

fn mfa_file(tok: string) -> string is
    return config::data_dir() + "/mfa/" + crypto::sha256_hex(tok)
end

pub fn mfa_create(username: string, ip: string) -> string is
    shell("mkdir -p " + util::sq(config::data_dir() + "/mfa") + " && chmod 700 " + util::sq(config::data_dir() + "/mfa"))
    let tok: string = new_token()
    util::write_private(mfa_file(tok), username + "\n" + ip + "\n" + to_string(now_unix() + 300))
    return tok
end

;; Username for a valid pending token bound to `ip` ("" otherwise).
pub fn mfa_peek(tok: string, ip: string) -> string is
    if tok == "" || !util::all_in(tok, util::alnum() + "-_") || !file_exists(mfa_file(tok)) is return "" end
    let ls: [string] = string_split(file_read(mfa_file(tok)), "\n")
    if array_len(ls) < 3 is return "" end
    if util::to_i(ls[2]) < now_unix() is
        fs_remove(mfa_file(tok))
        return ""
    end
    if ls[1] != ip is return "" end
    return ls[0]
end

pub fn mfa_consume(tok: string) is
    if tok != "" && util::all_in(tok, util::alnum() + "-_") is fs_remove(mfa_file(tok)) end
end

;; ── TOTP (RFC 6238, SHA-1, 6 digits, 30 s, ±1 step) ─────────────────────────

pub fn totp_at(secret: string, counter: int) -> string is
    let key: [int] = crypto::b32_decode_raw(string_upper(string_trim(secret)))
    if array_len(key) == 0 is return "" end
    let mut msg: [int] = []
    let mut s: int = 7
    while s >= 0 is
        msg = array_push(msg, (counter >> (s * 8)) & 255)
        s -= 1
    end
    let mac: [int] = crypto::hmac_sha1(key, msg)
    let off: int = mac[array_len(mac) - 1] & 15
    let code: int = ((mac[off] & 127) << 24) | (mac[off + 1] << 16) | (mac[off + 2] << 8) | mac[off + 3]
    let v: int = code % 1000000
    let s6: string = to_string(v)
    let mut pad: string = ""
    let mut k: int = string_len(s6)
    while k < 6 is
        pad = pad + "0"
        k += 1
    end
    return pad + s6
end

pub fn totp_verify(secret: string, code: string) -> bool is
    let c: string = string_trim(code)
    if string_len(c) != 6 || !util::is_digits(c) is return false end
    let step: int = now_unix() / 30
    let mut ok: bool = false
    let mut d: int = -1
    while d <= 1 is
        let want: string = totp_at(secret, step + d)
        if want != "" && crypto::ct_eq_str(want, c) is ok = true end
        d += 1
    end
    return ok
end

;; ── user management ──────────────────────────────────────────────────────────

pub fn user_set_raw(name: string, key: string, raw: string) -> bool is
    let us: [string] = user_objects()
    let mut out: [string] = []
    let mut found: bool = false
    let mut i: int = 0
    while i < array_len(us) is
        if util::jstr(us[i], "username") == name is
            found = true
            out = array_push(out, rebuild_with(us[i], key, raw))
        else is
            out = array_push(out, us[i])
        end
        i += 1
    end
    if found is write_users(out, util::jget(read_store(), "tokens")) end
    return found
end

;; Returns "" on success or an error message.
pub fn create_user(username: string, password: string, role: string) -> string is
    if !valid_username(username) is return "invalid username (letters, digits, . _ - ; max 32)" end
    if role_rank(role) == 0 is return "invalid role" end
    let pe: string = valid_password(password)
    if pe != "" is return pe end
    if user_find(username) != "" is return "user already exists" end
    let mut us: [string] = user_objects()
    us = array_push(us, user_object(username, hash_password(password), string_lower(string_trim(role))))
    write_users(us, util::jget(read_store(), "tokens"))
    return ""
end

pub fn delete_user(username: string) -> string is
    let u: string = user_find(username)
    if u == "" is return "no such user" end
    if role_rank(util::jstr(u, "role")) == 3 && active_admins_except(username) == 0 is
        return "cannot delete the last active administrator"
    end
    let us: [string] = user_objects()
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(us) is
        if util::jstr(us[i], "username") != username is out = array_push(out, us[i]) end
        i += 1
    end
    write_users(out, util::jget(read_store(), "tokens"))
    return ""
end

pub fn update_user(username: string, role: string, disabled: bool) -> string is
    if role_rank(role) == 0 is return "invalid role" end
    let u: string = user_find(username)
    if u == "" is return "no such user" end
    let was_admin: bool = role_rank(util::jstr(u, "role")) == 3 && !util::jbool(u, "disabled")
    if was_admin && (role_rank(role) != 3 || disabled) && active_admins_except(username) == 0 is
        return "cannot demote or disable the last active administrator"
    end
    user_set_str(username, "role", string_lower(string_trim(role)))
    user_set_raw(username, "disabled", util::jb(disabled))
    return ""
end

pub fn set_password(username: string, next: string) -> string is
    let pe: string = valid_password(next)
    if pe != "" is return pe end
    if user_find(username) == "" is return "no such user" end
    user_set_str(username, "password_hash", hash_password(next))
    return ""
end

pub fn change_password(username: string, current: string, next: string) -> string is
    if verify_user(username, current) == "" is return "current password is incorrect" end
    return set_password(username, next)
end

;; Users for the admin UI — never includes hashes or TOTP material.
pub fn users_public_json() -> string is
    let us: [string] = user_objects()
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(us) is
        let u: string = us[i]
        let mut pairs: [string] = [util::ks("username", util::jstr(u, "username")), util::ks("role", util::jstr(u, "role"))]
        if util::jbool(u, "disabled") is pairs = array_push(pairs, util::kv("disabled", "true")) end
        pairs = array_push(pairs, util::ks("created", util::jstr(u, "created")))
        if util::jbool(u, "totp_enabled") is pairs = array_push(pairs, util::kv("totp_enabled", "true")) end
        if util::jget(u, "scopes") != "" is pairs = array_push(pairs, util::kv("scopes", util::jget(u, "scopes"))) end
        out = array_push(out, util::jo(pairs))
        i += 1
    end
    return util::ja(out)
end

;; ── TOTP enrolment / login with backup codes ─────────────────────────────────

fn backup_hash(code: string) -> string is
    return crypto::sha256_hex(string_upper(string_trim(code)))
end

pub fn totp_enroll_begin(username: string) -> string is
    let secret: string = crypto::b32_encode_raw(crypto::rand_bytes(20))
    if !user_set_str(username, "pending_totp_secret", secret) is return "" end
    return secret
end

pub fn totp_uri(account: string, secret: string) -> string is
    return "otpauth://totp/HackerCockpit:" + url_encode(account) + "?secret=" + secret +
           "&issuer=HackerCockpit&algorithm=SHA1&digits=6&period=30"
end

;; Returns the 8 plain backup codes joined by '\n', or "ERR:<message>".
pub fn totp_enroll_confirm(username: string, code: string) -> string is
    let u: string = user_find(username)
    if u == "" is return "ERR:no such user" end
    let secret: string = util::jstr(u, "pending_totp_secret")
    if secret == "" is return "ERR:no pending enrollment — start again" end
    if !totp_verify(secret, code) is return "ERR:incorrect code" end
    let alphabet: string = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ"
    let mut plain: [string] = []
    let mut hashed: [string] = []
    let mut n: int = 0
    while n < 8 is
        let raw: [int] = crypto::rand_bytes(8)
        let mut c: string = ""
        let mut j: int = 0
        while j < 8 is
            if j == 4 is c = c + "-" end
            c = c + string_at(alphabet, raw[j] % 32)
            j += 1
        end
        plain = array_push(plain, c)
        hashed = array_push(hashed, backup_hash(c))
        n += 1
    end
    user_set_raw(username, "totp_secret", util::jq(secret))
    user_set_raw(username, "totp_enabled", "true")
    user_set_raw(username, "pending_totp_secret", util::jq(""))
    user_set_raw(username, "totp_backup_hashes", util::jstrs(hashed))
    return util::join(plain, "\n")
end

pub fn totp_enroll_cancel(username: string) -> bool is
    return user_set_raw(username, "pending_totp_secret", util::jq(""))
end

pub fn totp_disable(username: string) -> bool is
    if user_find(username) == "" is return false end
    user_set_raw(username, "totp_enabled", "false")
    user_set_raw(username, "totp_secret", util::jq(""))
    user_set_raw(username, "pending_totp_secret", util::jq(""))
    user_set_raw(username, "totp_backup_hashes", "[]")
    return true
end

pub fn totp_backup_remaining(username: string) -> int is
    return array_len(util::jstr_list(user_find(username), "totp_backup_hashes"))
end

pub fn totp_login_verify(username: string, code: string) -> bool is
    let u: string = user_find(username)
    if u == "" || !util::jbool(u, "totp_enabled") is return false end
    if totp_verify(util::jstr(u, "totp_secret"), code) is return true end
    let want: string = backup_hash(code)
    let hashes: [string] = util::jstr_list(u, "totp_backup_hashes")
    let mut rest: [string] = []
    let mut hit: bool = false
    let mut i: int = 0
    while i < array_len(hashes) is
        if !hit && crypto::ct_eq_str(hashes[i], want) is
            hit = true
        else is
            rest = array_push(rest, hashes[i])
        end
        i += 1
    end
    if hit is user_set_raw(username, "totp_backup_hashes", util::jstrs(rest)) end
    return hit
end

;; ── API tokens (Authorization: Bearer hck_…) ────────────────────────────────
;; Stored hashed (sha256) in auth.json → "tokens", exactly like the Go version.

fn tokens_raw() -> string is
    let t: string = util::jget(read_store(), "tokens")
    if t == "" is return "[]" end
    return t
end

fn save_tokens(items: [string]) is
    write_users(user_objects(), util::ja(items))
end

pub fn tokens_public_json() -> string is
    let items: [string] = util::jitems(tokens_raw())
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(items) is
        let t: string = items[i]
        let mut pairs: [string] = [util::ks("id", util::jstr(t, "id")), util::ks("name", util::jstr(t, "name")),
            util::ks("role", util::jstr(t, "role")), util::ks("owner", util::jstr(t, "owner")),
            util::ks("created", util::jstr(t, "created"))]
        if util::jstr(t, "last_used") != "" is pairs = array_push(pairs, util::ks("last_used", util::jstr(t, "last_used"))) end
        out = array_push(out, util::jo(pairs))
        i += 1
    end
    return util::ja(out)
end

;; Returns "ERR:<msg>" or "<plaintext>\n<id>".
pub fn token_create(name: string, owner: string, role: string) -> string is
    if string_len(name) == 0 || string_len(name) > 64 is return "ERR:token name required (max 64 chars)" end
    if role_rank(role) == 0 is return "ERR:invalid role" end
    let plain: string = "hck_" + crypto::b32_encode_raw(crypto::rand_bytes(24))
    let id: string = crypto::hex_of(crypto::rand_bytes(6))
    let item: string = util::jo([util::ks("id", id), util::ks("name", name), util::ks("hash", crypto::sha256_hex(plain)),
        util::ks("role", string_lower(string_trim(role))), util::ks("owner", owner), util::ks("created", util::now_iso())])
    let mut items: [string] = util::jitems(tokens_raw())
    items = array_push(items, item)
    save_tokens(items)
    return plain + "\n" + id
end

pub fn token_delete(id: string) -> bool is
    let items: [string] = util::jitems(tokens_raw())
    let mut out: [string] = []
    let mut hit: bool = false
    let mut i: int = 0
    while i < array_len(items) is
        if util::jstr(items[i], "id") == id is hit = true else is out = array_push(out, items[i]) end
        i += 1
    end
    if hit is save_tokens(out) end
    return hit
end

;; [name, role, scopes_raw] for a valid bearer secret, [] otherwise.
;; A token never outranks its owner; scopes come from the owner.
pub fn token_lookup(secret: string) -> [string] is
    if string_len(secret) < 12 || !string_starts_with(secret, "hck_") is return [] end
    let h: string = crypto::sha256_hex(secret)
    let items: [string] = util::jitems(tokens_raw())
    let mut i: int = 0
    while i < array_len(items) is
        let t: string = items[i]
        if crypto::ct_eq_str(util::jstr(t, "hash"), h) is
            let owner: string = user_find(util::jstr(t, "owner"))
            if owner == "" || util::jbool(owner, "disabled") is return [] end
            let mut role: string = util::jstr(t, "role")
            if role_rank(util::jstr(owner, "role")) < role_rank(role) is role = util::jstr(owner, "role") end
            return ["token:" + util::jstr(t, "name"), role, util::jget(owner, "scopes")]
        end
        i += 1
    end
    return []
end

;; ── per-user scopes ──────────────────────────────────────────────────────────

pub fn scopes_set(username: string, raw: string) -> bool is
    return user_set_raw(username, "scopes", raw)
end

;; Items of `global` that are also in `scope` (an empty scope means "all").
pub fn intersect(global: [string], scope: [string]) -> [string] is
    if array_len(scope) == 0 is return global end
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(global) is
        if util::has(scope, global[i]) is out = array_push(out, global[i]) end
        i += 1
    end
    return out
end

pub fn under_any(roots: [string], path: string) -> bool is
    let mut i: int = 0
    while i < array_len(roots) is
        let r: string = roots[i]
        let base: string = if string_len(r) > 1 && string_ends_with(r, "/") then string_slice(r, 0, string_len(r) - 1) else r
        if r == "/" || path == r || string_starts_with(path, base + "/") is return true end
        i += 1
    end
    return false
end

pub fn in_scope_path(global_roots: [string], scope_roots: [string], path: string) -> bool is
    if !under_any(global_roots, path) is return false end
    return array_len(scope_roots) == 0 || under_any(scope_roots, path)
end
