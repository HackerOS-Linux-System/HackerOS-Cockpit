;; ── tokens ───────────────────────────────────────────────────────────────────

pub fn tokens(fd: int, c: [string]) is
    http::respond_json(fd, 200, "{{\"tokens\":" + auth::tokens_public_json() + "}}")
end

pub fn token_create(fd: int, c: [string]) is
    let r: string = auth::token_create(ctx::bstr(c, "name"), ctx::user(c), ctx::bstr(c, "role"))
    if string_starts_with(r, "ERR:") is
        http::err(fd, 400, string_slice(r, 4, string_len(r)))
        return
    end
    let parts: [string] = string_split(r, "\n")
    audit::log(ctx::user(c), "token.create", ctx::bstr(c, "name") + " (" + ctx::bstr(c, "role") + ")")
    http::respond_json(fd, 200, util::jo([util::ks("status", "success"), util::ks("token", parts[0]), util::ks("id", parts[1]),
        util::ks("message", "Copy the token now — it is shown only once.")]))
end

pub fn token_delete(fd: int, c: [string], id: string) is
    if !auth::token_delete(id) is
        http::err(fd, 404, "no such token")
        return
    end
    audit::log(ctx::user(c), "token.delete", id)
    http::ok(fd, "token deleted")
end

;; ── scopes ───────────────────────────────────────────────────────────────────

pub fn user_scopes(fd: int, c: [string], name: string) is
    let b: string = ctx::body(c)
    if auth::user_find(name) == "" is
        http::err(fd, 400, "no such user")
        return
    end
    if !util::jbool(b, "enabled") is
        auth::scopes_set(name, "null")
        audit::log(ctx::user(c), "panel-user.scopes-cleared", name)
        http::ok(fd, "scope removed — account now has full role-level access")
        return
    end
    let services: [string] = auth::intersect(settings::services(), util::jstr_list(b, "services"))
    let logs: [string] = auth::intersect(settings::allowed_logs(), util::jstr_list(b, "log_files"))
    let mut roots: [string] = []
    let want: [string] = util::jstr_list(b, "file_roots")
    let mut i: int = 0
    while i < array_len(want) is
        if auth::in_scope_path(settings::file_roots(), [], want[i]) is roots = array_push(roots, want[i]) end
        i += 1
    end
    let ids: [string] = util::jstr_list(b, "backups")
    let mut ok_ids: [string] = []
    let mut k: int = 0
    while k < array_len(ids) is
        if m_backup::find(ids[k]) != "" is ok_ids = array_push(ok_ids, ids[k]) end
        k += 1
    end
    let sc: string = util::jo([util::kv("services", util::jstrs(services)), util::kv("log_files", util::jstrs(logs)),
        util::kv("file_roots", util::jstrs(roots)), util::kv("backups", util::jstrs(ok_ids))])
    auth::scopes_set(name, sc)
    audit::log(ctx::user(c), "panel-user.scopes-set", name)
    http::respond_json(fd, 200, util::jo([util::ks("status", "success"), util::ks("message", "scope updated"), util::kv("scopes", sc)]))
end

;; ── settings ─────────────────────────────────────────────────────────────────

pub fn settings_get(fd: int, c: [string]) is
    let ro: string = util::jo([util::ks("data_dir", config::data_dir()), util::kv("auth", util::jb(config::auth_enabled())), util::kv("tls", util::jb(config::tls_cert() != "")),
        util::kv("trust_proxy", util::jb(config::trust_proxy())), util::ks("search_provider", config::search_provider()), util::ks("listen", config::host()),
        util::ks("version", config::version())])
    http::respond_json(fd, 200, util::jo([util::kv("settings", settings::view_of(settings::load())), util::kv("readonly", ro)]))
end

fn clean_abs(p: string) -> string is
    let r: string = string_trim(p)
    if r == "" is return "" end
    return string_trim(shell("realpath -m -- " + util::sq(r) + " 2>/dev/null"))
end

fn valid_service_name(n: string) -> bool is
    return string_len(n) > 0 && string_len(n) <= 100 && !string_starts_with(n, "-") && util::all_in(n, util::alnum() + "@_.-")
end

fn clean_paths(items: [string]) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(items) is
        out = array_push(out, clean_abs(items[i]))
        i += 1
    end
    return out
end

;; Validates a merged settings object (already normalised). "" or error text.
fn validate(s: string) -> string is
    let svc: [string] = array_concat(util::jstr_list(s, "services"), util::jstr_list(s, "notify_services"))
    let mut i: int = 0
    while i < array_len(svc) is
        if !valid_service_name(svc[i]) is return "invalid service name: " + svc[i] end
        i += 1
    end
    let logs: [string] = util::jstr_list(s, "allowed_logs")
    i = 0
    while i < array_len(logs) is
        if !string_starts_with(clean_abs(logs[i]), "/") is return "log files must be absolute paths" end
        i += 1
    end
    let roots: [string] = util::jstr_list(s, "file_roots")
    if array_len(roots) == 0 is return "at least one file root is required" end
    i = 0
    while i < array_len(roots) is
        let r: string = clean_abs(roots[i])
        if !string_starts_with(r, "/") is return "file roots must be absolute paths" end
        if !util::is_dir(r) is return "file root is not an existing directory: " + r end
        i += 1
    end
    let hook: string = util::jstr(s, "webhook_url")
    if hook != "" && !(string_starts_with(hook, "http://") || string_starts_with(hook, "https://")) is return "webhook must be an http(s) URL" end
    let em: string = notify::email_validate(util::jget(s, "email"))
    if em != "" is return "e-mail alerts: " + em end
    let d: int = util::jint(s, "disk_warn_pct")
    let m: int = util::jint(s, "mem_warn_pct")
    if d < 1 || d > 100 || m < 1 || m > 100 is return "thresholds must be between 1 and 100" end
    let cd: int = util::jint(s, "cert_warn_days")
    if cd < 1 || cd > 365 is return "certificate warning must be 1–365 days" end
    return m_misc::host_validate_all(util::jget(s, "hosts"))
end

;; Normalised copy with cleaned absolute paths.
fn with_clean_paths(s: string) -> string is
    let logs: [string] = clean_paths(util::jstr_list(s, "allowed_logs"))
    let roots: [string] = clean_paths(util::jstr_list(s, "file_roots"))
    return util::jo([util::kv("services", util::jget(s, "services")), util::kv("allowed_logs", util::jstrs(logs)), util::kv("file_roots", util::jstrs(roots)),
        util::kv("notify_services", util::jget(s, "notify_services")), util::ks("webhook_url", util::jstr(s, "webhook_url")), util::kv("email", util::jget(s, "email")),
        util::kv("disk_warn_pct", util::jget(s, "disk_warn_pct")), util::kv("mem_warn_pct", util::jget(s, "mem_warn_pct")),
        util::kv("cert_warn_days", util::jget(s, "cert_warn_days")), util::kv("hosts", util::jget(s, "hosts"))])
end

fn merge_secrets(input: string, old: string) -> string is
    ;; keep the stored e-mail password / host tokens when the browser sent none
    let em: string = util::jget(input, "email")
    let oldem: string = util::jget(old, "email")
    let pw: string = if util::jstr(em, "password") == "" then util::jstr(oldem, "password") else util::jstr(em, "password")
    let em2: string = util::jo([util::kv("enabled", util::jb(util::jbool(em, "enabled"))), util::ks("host", util::jstr(em, "host")), util::kv("port", util::ji(util::jint(em, "port"))),
        util::ks("security", util::jstr(em, "security")), util::ks("username", util::jstr(em, "username")), util::ks("password", pw), util::ks("from", util::jstr(em, "from")),
        util::kv("to", util::jstrs(util::jstr_list(em, "to"))), util::ks("min_level", util::jstr(em, "min_level"))])
    let hosts: [string] = util::jitems(util::jget(input, "hosts"))
    let oldh: [string] = util::jitems(util::jget(old, "hosts"))
    let mut hv: [string] = []
    let mut i: int = 0
    while i < array_len(hosts) is
        let h: string = hosts[i]
        let mut tok: string = util::jstr(h, "token")
        if tok == "" is
            let mut k: int = 0
            while k < array_len(oldh) is
                if util::jstr(oldh[k], "name") == util::jstr(h, "name") && util::jstr(oldh[k], "url") == util::jstr(h, "url") is tok = util::jstr(oldh[k], "token") end
                k += 1
            end
        end
        hv = array_push(hv, util::jo([util::ks("name", util::jstr(h, "name")), util::ks("url", util::jstr(h, "url")), util::ks("token", tok), util::kv("insecure", util::jb(util::jbool(h, "insecure")))]))
        i += 1
    end
    return util::jo([util::kv("services", util::jget(input, "services")), util::kv("allowed_logs", util::jget(input, "allowed_logs")), util::kv("file_roots", util::jget(input, "file_roots")),
        util::kv("notify_services", util::jget(input, "notify_services")), util::ks("webhook_url", util::jstr(input, "webhook_url")), util::kv("email", em2),
        util::kv("disk_warn_pct", util::jget(input, "disk_warn_pct")), util::kv("mem_warn_pct", util::jget(input, "mem_warn_pct")),
        util::kv("cert_warn_days", util::jget(input, "cert_warn_days")), util::kv("hosts", util::ja(hv))])
end

pub fn settings_put(fd: int, c: [string]) is
    let merged: string = merge_secrets(ctx::body(c), settings::load())
    let next: string = with_clean_paths(settings::normalize(merged))
    let e: string = validate(next)
    if e != "" is
        http::err(fd, 400, e)
        return
    end
    settings::replace(next, ctx::user(c))
    audit::log(ctx::user(c), "settings.update", "")
    http::ok(fd, "settings saved")
end

pub fn settings_history(fd: int, c: [string]) is
    let items: [string] = util::jitems(settings::history_json())
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(items) is
        out = array_push(out, util::jo([util::kv("id", util::ji(util::jint(items[i], "id"))), util::ks("time", util::jstr(items[i], "time")),
            util::ks("actor", util::jstr(items[i], "actor")), util::kv("settings", settings::view_of(util::jget(items[i], "settings")))]))
        i += 1
    end
    http::respond_json(fd, 200, "{{\"history\":" + util::ja(out) + "}}")
end

pub fn settings_rollback(fd: int, c: [string], id_s: string) is
    if !util::is_digits(id_s) is
        http::err(fd, 400, "invalid version id")
        return
    end
    let restored: string = settings::rollback(util::to_i(id_s), ctx::user(c))
    if restored == "" is
        http::err(fd, 400, "no such settings version")
        return
    end
    audit::log(ctx::user(c), "settings.rollback", id_s)
    http::respond_json(fd, 200, util::jo([util::ks("status", "success"), util::ks("message", "settings restored"), util::kv("settings", settings::view_of(restored))]))
end

pub fn settings_export(fd: int, c: [string]) is
    let doc: string = util::jo([util::ks("format", "hackercockpit-config/1"), util::ks("version", config::version()), util::ks("exported", util::now_iso()),
        util::kv("settings", settings::view_of(settings::load())), util::kv("firewall_rules", m_fw::export_specs()), util::kv("backup_profiles", m_backup::export_profiles())])
    audit::log(ctx::user(c), "settings.export", "")
    http::respond_json_h(fd, 200, "Content-Disposition: attachment; filename=\"hackercockpit-config.json\"\r\n", doc)
end

pub fn settings_import(fd: int, c: [string]) is
    let doc: string = ctx::body(c)
    if util::jstr(doc, "format") != "hackercockpit-config/1" is
        http::err(fd, 400, "not a HackerCockpit configuration export")
        return
    end
    let apply: string = util::jget(doc, "apply")
    let mut report: [string] = []
    if util::jbool(apply, "settings") is
        let st: string = util::jget(doc, "settings")
        let cur: string = settings::load()
        let next0: string = util::jo([util::kv("services", util::jget(st, "services")), util::kv("allowed_logs", util::jget(st, "allowed_logs")), util::kv("file_roots", util::jget(st, "file_roots")),
            util::kv("notify_services", util::jget(st, "notify_services")), util::ks("webhook_url", util::jstr(st, "webhook_url")), util::kv("email", util::jget(cur, "email")),
            util::kv("disk_warn_pct", util::jget(st, "disk_warn_pct")), util::kv("mem_warn_pct", util::jget(st, "mem_warn_pct")),
            util::kv("cert_warn_days", util::jget(st, "cert_warn_days")), util::kv("hosts", util::jget(cur, "hosts"))])
        let next: string = with_clean_paths(settings::normalize(next0))
        let e: string = validate(next)
        if e != "" is
            http::err(fd, 400, "settings: " + e)
            return
        end
        settings::replace(next, ctx::user(c) + " (import)")
        report = array_push(report, util::ks("settings", "applied (fleet hosts are never imported)"))
    end
    if util::jbool(apply, "backups") is
        let r: [int] = m_backup::import_profiles(util::jget(doc, "backup_profiles"))
        report = array_push(report, util::kv("backups", util::jo([util::kv("added", util::ji(r[0])), util::kv("skipped", util::ji(r[1]))])))
    end
    if util::jbool(apply, "firewall") is
        let rules: [string] = util::jitems(util::jget(doc, "firewall_rules"))
        let mut added: int = 0
        let mut skipped: int = 0
        let mut i: int = 0
        while i < array_len(rules) is
            if m_fw::import_spec(rules[i]) is added += 1 else is skipped += 1 end
            i += 1
        end
        report = array_push(report, util::kv("firewall", util::jo([util::kv("added", util::ji(added)), util::kv("skipped", util::ji(skipped))])))
    end
    audit::log(ctx::user(c), "settings.import", "")
    http::respond_json(fd, 200, util::jo([util::ks("status", "success"), util::ks("message", "import finished"), util::kv("report", util::jo(report))]))
end

pub fn test_webhook(fd: int, c: [string]) is
    let mut url: string = ctx::bstr(c, "url")
    if url == "" is url = settings::webhook() end
    if !(string_starts_with(url, "http://") || string_starts_with(url, "https://")) || string_len(url) < 11 is
        http::err(fd, 400, "webhook must be an http(s) URL")
        return
    end
    let body: string = util::jo([util::ks("text", "[info] HackerCockpit test — webhook works (" + system::hostname() + ")"),
        util::ks("host", system::hostname()), util::ks("level", "info"), util::ks("kind", "test"), util::ks("title", "Test notification"), util::ks("time", util::now_iso())])
    let e: string = notify::post_webhook(url, body)
    if e != "" is
        http::err(fd, 502, e)
        return
    end
    http::ok(fd, "webhook answered OK")
end

pub fn test_email(fd: int, c: [string]) is
    let b: string = ctx::body(c)
    let cur: string = settings::email()
    let mut em: string = cur
    if util::jstr(b, "host") != "" is
        let pw: string = if util::jstr(b, "password") == "" then util::jstr(cur, "password") else util::jstr(b, "password")
        em = util::jo([util::kv("enabled", "true"), util::ks("host", util::jstr(b, "host")), util::kv("port", util::ji(util::jint(b, "port"))), util::ks("security", util::jstr(b, "security")),
            util::ks("username", util::jstr(b, "username")), util::ks("password", pw), util::ks("from", util::jstr(b, "from")), util::kv("to", util::jstrs(util::jstr_list(b, "to"))), util::ks("min_level", "info")])
    else is
        em = util::jo([util::kv("enabled", "true"), util::ks("host", util::jstr(cur, "host")), util::kv("port", util::ji(util::jint(cur, "port"))), util::ks("security", util::jstr(cur, "security")),
            util::ks("username", util::jstr(cur, "username")), util::ks("password", util::jstr(cur, "password")), util::ks("from", util::jstr(cur, "from")),
            util::kv("to", util::jstrs(util::jstr_list(cur, "to"))), util::ks("min_level", "info")])
    end
    let e: string = notify::send_email(em, "[HackerCockpit] test e-mail", "This is a test message from HackerCockpit on " + system::hostname() + ".\nIf you can read it, e-mail alerts work.\n")
    if e != "" is
        http::err(fd, 502, e)
        return
    end
    http::ok(fd, "test e-mail sent")
end
