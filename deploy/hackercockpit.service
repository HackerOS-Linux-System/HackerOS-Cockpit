[Unit]
Description=HackerOS Cockpit (H#)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/hackercockpit
Environment=HCKPT_AUTH=1
Environment=HCKPT_HOST=127.0.0.1
Environment=HCKPT_PORT=4545
Environment=HCKPT_TRUST_PROXY=1
Environment=HCKPT_COOKIE_SECURE=1
Environment=HCKPT_DATA_DIR=/var/lib/hackercockpit
Restart=on-failure
RestartSec=3
# the panel manages services, users, firewall, backups… so it runs as root;
# narrow this down (User=, AmbientCapabilities=, sudoers) if you only need monitoring.
User=root
NoNewPrivileges=false
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
